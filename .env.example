# ==========================================
# WhatsApp CRM Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL - Private VPC / Internal Network Only)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_crm?schema=public"

# Frontend URL (Used for CORS and Password Reset Links)
FRONTEND_URL="http://localhost:5173"

# JWT Secrets (Generate secure random 64-char hex strings in production)
JWT_ACCESS_SECRET="your_very_strong_and_secure_jwt_access_secret_key_minimum_32_characters_long_12345"
JWT_REFRESH_SECRET="your_very_strong_and_secure_jwt_refresh_secret_key_minimum_32_characters_long_67890"
JWT_RESET_PASSWORD_SECRET="your_very_strong_and_secure_jwt_reset_password_secret_key_minimum_32_chars_abc"

# =========================================================================
# Cryptographic Key Separation (Defense in Depth - AES-256-GCM)
# In Production: inject via Doppler / HashiCorp Vault / Cloud Secrets Manager
# NEVER share keys between phone numbers, salaries, and biometric data.
# =========================================================================

# Phone Encryption Key (Customer & Staff phone numbers)
PHONE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Salary Encryption Key (Employee base salaries & financial compensation)
SALARY_ENCRYPTION_KEY="f1e2d3c4b5a69788f1e2d3c4b5a69788f1e2d3c4b5a69788f1e2d3c4b5a69788"

# Biometric Vector Encryption Key (Facial cosine embedding vectors)
FACE_EMBEDDING_ENCRYPTION_KEY="99887766554433221100aabbccddeeff99887766554433221100aabbccddeeff"

# Database Backup Encryption Key (Dedicated key for offsite encrypted pg_dump archives)
BACKUP_ENCRYPTION_KEY="7766554433221100aabbccddeeff00117766554433221100aabbccddeeff0011"

# Security & Cookies
SECURE_COOKIE=false
COOKIE_SAME_SITE="lax"

# Sentry Monitoring (Optional - provide your Sentry DSN in production)
SENTRY_DSN=""

# Postgres Row Level Security (RLS) feature flag
ENABLE_RLS=false

# Client-side env (Used by Vite)
# VITE_API_URL="http://localhost:5000/api"
