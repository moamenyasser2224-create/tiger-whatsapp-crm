# ==========================================
# WhatsApp CRM Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_crm?schema=public"

# Frontend URL (Used for CORS and Password Reset Links)
FRONTEND_URL="http://localhost:5173"

# JWT Secrets (Generate secure random 64-char hex strings in production)
JWT_ACCESS_SECRET="your_very_strong_and_secure_jwt_access_secret_key_minimum_32_characters_long_12345"
JWT_REFRESH_SECRET="your_very_strong_and_secure_jwt_refresh_secret_key_minimum_32_characters_long_67890"
JWT_RESET_PASSWORD_SECRET="your_very_strong_and_secure_jwt_reset_password_secret_key_minimum_32_chars_abc"

# Phone Encryption Key (Must be exactly 32 bytes / 64 hex characters for AES-256-GCM)
# Example generated via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHONE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Security & Cookies
SECURE_COOKIE=false
COOKIE_SAME_SITE="lax"

# Sentry Monitoring (Optional - provide your Sentry DSN in production)
SENTRY_DSN=""

# Postgres Row Level Security (RLS) feature flag
ENABLE_RLS=false

# Client-side env (Used by Vite)
# VITE_API_URL="http://localhost:5000/api"
