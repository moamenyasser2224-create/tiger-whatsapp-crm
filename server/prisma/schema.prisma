datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  password           String
  name               String
  role               String               @default("employee") // [admin, employee]
  isTwoFactorEnabled Boolean              @default(false)
  twoFactorSecret    String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?

  customers           Customer[]
  messageTemplates    MessageTemplate[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  attendances         Attendance[]
  chatMessages        ChatMessage[]

  @@map("users")
}

model Customer {
  id          String    @id @default(uuid())
  userId      String
  name        String
  company     String?
  phone       String    // Stored as AES-256-GCM encrypted string
  phoneHash   String    // SHA-256 HMAC or Hash for fast indexing & duplicate detection per user
  city        String?
  source      String?   @default("واتساب")
  status      String?   @default("جديد")
  sourceId    String?
  statusId    String?
  last        DateTime?
  next        DateTime?
  notes       String?   @db.Text
  consent     Boolean   @default(true)
  consentDate DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceOption ListOption? @relation("CustomerSource", fields: [sourceId], references: [id])
  statusOption ListOption? @relation("CustomerStatus", fields: [statusId], references: [id])

  @@index([userId, deletedAt])
  @@index([userId, phoneHash])
  @@index([userId, next, status])
  @@map("customers")
}

model ListOption {
  id        String   @id @default(uuid())
  type      String   // "source" | "status"
  label     String
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceCustomers Customer[]        @relation("CustomerSource")
  statusCustomers Customer[]        @relation("CustomerStatus")
  templates       MessageTemplate[]

  @@index([type, order])
  @@map("list_options")
}

model Settings {
  id        String   @id @default(uuid())
  orgName   String   @default("تايجر CRM")
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model MessageTemplate {
  id        String      @id @default(uuid())
  userId    String
  status    String?
  statusId  String?
  body      String      @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusOption ListOption? @relation(fields: [statusId], references: [id])

  @@map("message_templates")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // CREATE, UPDATE, DELETE, EXPORT, LOGIN, 2FA_ENABLE, etc.
  entity    String   // CUSTOMER, TEMPLATE, USER, AUTH
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Attendance {
  id        String    @id @default(uuid())
  userId    String
  date      String    // YYYY-MM-DD
  checkIn   DateTime?
  checkOut  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@map("attendances")
}

model ChatMessage {
  id        String   @id @default(uuid())
  senderId  String
  text      String   @db.Text
  createdAt DateTime @default(now())

  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("chat_messages")
}

